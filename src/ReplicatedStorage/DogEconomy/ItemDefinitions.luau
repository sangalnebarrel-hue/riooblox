local seen: { [string]: number } = {}
for _, row in ipairs(UNDERYARD_FINDS) do
	local tier = UNDERYARD_TIERS[row.Tier]
	assert(tier and Items[row.Id] == nil, "Underyard find " .. row.Id)
	local n = seen[row.Tier] or 0
	seen[row.Tier] = n + 1
	Items[row.Id] = {
		Id = row.Id,
		DisplayName = row.Name,
		Depth = 4,
		Class = "Underyard",
		SetId = "",
		BaseDropChance = tier.Chance,
		BaseWeightKg = row.Kg,
		WeightProfile = row.Profile,
		-- a little more for the later finds of a tier, so the sale prices of one tier are not identical
		BaseValue = tier.Value + n * math.floor(tier.Value / 20),
		VisualAsset = row.Id,
		ScaleCap = 8,
		MaxWeightMultiplier = 0,
		Description = row.Text,
		-- event data (no other system reads these): collection, tier and Russian names for self-localized UI
		Event = "Underyard2026",
		Showcase = row.Tier,
		RU = row.RU,
		DescriptionRU = row.TextRU,
		CanDropFromRoulette = false,
	}
end

return Items
