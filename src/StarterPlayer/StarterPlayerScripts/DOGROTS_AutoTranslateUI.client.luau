    local function isRussian()
        return locale:sub(1, 2):lower() == "ru"
    end

    local function currentLocale()
        if RunService:IsStudio() then
            return LocalizationService.RobloxLocaleId or "en-us"
        end
        return player.LocaleId or LocalizationService.RobloxLocaleId or "en-us"
    end

    local function translatorLookup(context, source)
        if not translator then return source end
        local saved = cache[source]
        if saved ~= nil then return saved end
        local ok, result = pcall(function()
            return translator:Translate(context, source)
        end)
        if not ok or type(result) ~= "string" or result == source then
            ok, result = pcall(function()
                return translator:Translate(game, source)
            end)
        end
        if ok and type(result) == "string" and result ~= source then
            cache[source] = result
            return result
        end
        cache[source] = source
        return source
    end

    local function escapePattern(s)
        return (s:gsub("([%%%^%$%(%)%.%[%]%*%+%-%?])", "%%%1"))
    end

    local function translatedLine(line, context)
        if line == "" then return line end
        if extra[line] then return extra[line] end
        local output = line
        local changed = false
        for _, rule in ipairs(patterns) do
            local result, n = output:gsub(rule[1], rule[2])
            if n > 0 and result ~= output then
                output = result
                changed = true
            end
        end
        -- Whole-string translation from the Roblox Cloud Localization Table.
        if not changed then
            local found = translatorLookup(context, line)
            if found ~= line then return found end
        end
        -- Compound labels ("TREASURE FEVER · COMMON") contain separate words.
        if output:find(" · ", 1, true) then
            output = output:gsub("([^·]+)", function(part)
                local leading, core, trailing = part:match("^(%s*)(.-)(%s*)$")
                if not core or core == "" then return part end
                local v = extra[core] or translatorLookup(context, core)
                return leading .. (v or core) .. trailing
            end)
        end
        -- Replace the recognizable longer phrases in dynamic sentences.
        if output:find("%s") or output:find("·", 1, true) then
            for _, pair in ipairs(phrases) do
                local from, to = pair[1], pair[2]
                if output:find(from, 1, true) then
                    local result, n = output:gsub(escapePattern(from), function() return to end)
                    if n > 0 then output = result end
                end
            end
        end
        return output
    end

    local function translateUI(source, context)
        if type(source) ~= "string" or source == "" or not isRussian() then return source end
        -- Text without Latin letters (already Russian, numbers, icons) never needs translating.
        if not source:find("[A-Za-z]") then return source end
        if extra[source] then return extra[source] end
        local whole = translatorLookup(context, source)
        if whole ~= source then return whole end
        local pieces = {}
        for line, separator in (source .. "\n"):gmatch("(.-)(\n)") do
            table.insert(pieces, translatedLine(line, context))
        end
        return table.concat(pieces, "\n")
    end

    local function retranslate(obj)
        local state = originals[obj]
        if not state or not obj.Parent then return end
        if state.busy then return end
        local property = state.property
        local current = obj[property]
        if current ~= state.lastApplied then
            state.original = current
        end
        local target = translateUI(state.original, obj)
        state.lastApplied = target
        if current ~= target then
            state.busy = true
            obj[property] = target
            state.busy = false
        end
    end

    local function watchObject(obj)
        if watching[obj] then return end
        -- GUIs that localize themselves (e.g. Active Mining) opt out with a NoTranslate attribute.
        if obj:GetAttribute("NoTranslate") then return end
        local layer = obj:FindFirstAncestorWhichIsA("LayerCollector")
        if layer and layer:GetAttribute("NoTranslate") then return end
        local property
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            property = "Text"
        elseif obj:IsA("TextBox") then
            property = "PlaceholderText"  -- Never modify the user's typed text.
        else
            return
        end
        watching[obj] = true
        originals[obj] = {property = property, original = obj[property], lastApplied = obj[property], busy = false}
        obj:GetPropertyChangedSignal(property):Connect(function()
            retranslate(obj)
        end)
        retranslate(obj)
    end

    local function reloadLocale()
        locale = currentLocale():lower()
        table.clear(cache)
        translator = nil
        if isRussian() then
            local ok, obj = pcall(function()
                return LocalizationService:GetTranslatorForLocaleAsync(locale)
            end)
            if ok then translator = obj end
        end
        for obj in pairs(originals) do
            if obj.Parent then retranslate(obj) end
        end
        print("DOGROTS localization active:", locale)
    end

    -- Run before scanning, so the initial English source text is preserved.
    reloadLocale()
    for _, root in ipairs(roots) do
        root.DescendantAdded:Connect(function(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                task.defer(watchObject, obj)
            end
        end)
        local descendants = root:GetDescendants()
        for i, obj in ipairs(descendants) do
            watchObject(obj)
            if i % 1200 == 0 then task.wait() end
        end
    end
    player:GetPropertyChangedSignal("LocaleId"):Connect(reloadLocale)
    LocalizationService:GetPropertyChangedSignal("RobloxLocaleId"):Connect(reloadLocale)
end

